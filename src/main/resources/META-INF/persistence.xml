<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="ClinicManagerPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>clinicmanager.model.User</class>
        <class>clinicmanager.model.Patient</class>
        <class>clinicmanager.model.Doctor</class>
        <class>clinicmanager.model.Absence</class>
        <class>clinicmanager.model.Appointment</class>
        <class>clinicmanager.model.Availability</class>
        <class>clinicmanager.model.Department</class>
        <class>clinicmanager.model.MedicalNote</class>
        <class>clinicmanager.model.Specialty</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/clinic_manager"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="hotel_user"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="hotel_password"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>
</persistence>
